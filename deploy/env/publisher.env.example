NODE_ENV=production
TZ=Asia/Tehran
IS_MULTI_ORG=true
PORT=4000
WORKER_COUNT=1
PUBLIC_BASE_URL=https://example.invalid
DASHBOARD_URL=https://example.invalid
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://example.invalid

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=elecio_social_publisher
DB_USER=elecio_publisher
DB_PASS=

NATS_URL=nats://127.0.0.1:4222

S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=elecio-publisher
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

INTEGRATION_CONFIG_ENCRYPTION_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_API_MODE=local
TELEGRAM_BOT_API_BASE_URL=http://127.0.0.1:8081
TELEGRAM_LOCAL_FILES_DIR=/var/lib/elecio/telegram-bot-api/files

YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=https://example.invalid/api/youtube/oauth/callback
YOUTUBE_UPLOAD_CHUNK_BYTES=8388608

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://example.invalid/api/linkedin/oauth/callback

APARAT_CONNECT_BASE_URL=https://example.invalid

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
PUBLISHER_MEDIA_TEMP_DIR=/var/tmp/elecio-publisher
MAX_MEDIA_BYTES=314572800
MAX_COVER_BYTES=10485760

